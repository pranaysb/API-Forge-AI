{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--reload", "--port", "8010"],
      "cwd": "backend",
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3010"],
      "cwd": "frontend",
      "port": 3010
    }
  ]
}
